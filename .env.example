# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Real Nigerian Bank Account Verification Provider (Paystack)
# Supported: 'paystack' (default), 'flutterwave'
BANK_VERIFICATION_PROVIDER=paystack
# Paystack Secret Key (MUST start with sk_live_ or sk_test_ from Paystack Dashboard > Settings > API Keys & Webhooks)
PAYSTACK_SECRET_KEY=
# Paystack Public Key (starts with pk_live_ or pk_test_)
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email Notifications (Management Alerts)
NEXOVIRA_ADMIN_EMAIL=nexoviratech@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=


