# GEMINI_API_KEY: Required for Gemini AI API calls (SERVER-SIDE ONLY - NEVER expose to browser)
GEMINI_API_KEY=

# APP_URL: The canonical URL where this applet is hosted
APP_URL=https://nexovira.com.ng

# Real Nigerian Bank Account Verification Provider (Paystack)
# Supported: 'paystack' (default), 'flutterwave'
BANK_VERIFICATION_PROVIDER=paystack

# Paystack Secret Key (SERVER-SIDE ONLY - starts with sk_live_ or sk_test_)
# MUST NEVER be prefixed with VITE_ or exposed to client-side code
PAYSTACK_SECRET_KEY=

# Paystack Public Key (Client-safe public checkout key - starts with pk_live_ or pk_test_)
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_PUBLIC_KEY=

# Flutterwave Secret Key (SERVER-SIDE ONLY - NEVER expose to browser)
FLUTTERWAVE_SECRET_KEY=

# Firebase Client Configuration (Client-safe public credentials)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Email Notifications (Management Alerts - SERVER-SIDE ONLY)
NEXOVIRA_ADMIN_EMAIL=nexovirasupport@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=


